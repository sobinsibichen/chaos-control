<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.LAST_PUFF_VOICE_COMMAND"
        app:queryPatterns="@array/last_puff_voice_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lastpuff.mobile"
            android:targetClass="com.lastpuff.mobile.VoiceAssistantActivity">
            <parameter
                android:name="command"
                android:key="command"
                android:mimeType="https://schema.org/Text" />
        </intent>
    </capability>
</shortcuts>
