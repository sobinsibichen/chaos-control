<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="LAST PUFF PROTECTION"
        android:textAllCaps="true"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/blocked_app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blocked_app_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#CBD5E1"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/blocked_app_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <Button
        android:id="@+id/blocked_open_last_puff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="#FFFFFF"
        android:padding="14dp"
        android:text="Open Last Puff To Unlock"
        android:textAllCaps="false"
        android:textColor="#0F172A" />

    <Button
        android:id="@+id/blocked_go_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1E293B"
        android:padding="14dp"
        android:text="Go To Home Screen"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
